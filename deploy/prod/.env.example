# /opt/desk-prod/.env  (chmod 600). Generate secrets with: openssl rand -hex 32
DB_OWNER_PASSWORD=
DB_APP_PASSWORD=
APP_SECRET=
PUBLIC_URL=https://desk.claviq.com
# local = files on the desk_data volume; r2 = Cloudflare R2 (fill the R2_* values)
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
