# Caddy reverse proxy for desk.claviq.com (one domain, one automatic HTTPS cert).
# Go (API, MCP, OAuth) on :8080, Next.js on :3000, both bound to localhost only.
desk.claviq.com {
	encode zstd gzip

	@go path /api/* /mcp /mcp/* /oauth/* /.well-known/oauth-*
	handle @go {
		reverse_proxy 127.0.0.1:8080 {
			# MCP streams responses (SSE): never buffer.
			flush_interval -1
		}
	}

	handle {
		reverse_proxy 127.0.0.1:3000
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}

	request_body {
		max_size 20MB
	}
}
