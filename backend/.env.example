APP_ENV=development
HTTP_ADDR=:8080
# Public origin (OAuth issuer, preview links). In dev: the Next.js dev server.
PUBLIC_URL=http://localhost:3000
# Root secret for sessions, signed links and OAuth (>= 32 chars). `openssl rand -hex 32`
APP_SECRET=change-me-change-me-change-me-change-me
# Runtime connection: app role, RLS enforced
DATABASE_URL=postgres://claviq_app:claviq_app@localhost:5432/claviq_desk?sslmode=disable
# Owner connection: migrations and create-tenant only
MIGRATE_DATABASE_URL=postgres://claviq:claviq@localhost:5432/claviq_desk?sslmode=disable
DATA_DIR=./data
TYPST_BIN=typst
# local | r2
STORAGE_DRIVER=local
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
